{
  "name": "lumaboard",
  "version": "1.8.9",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run --exclude \"dist/**\"",
    "security:scan": "node scripts/security-scan.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:signatures": "npm audit signatures",
    "security:full": "npm run security:scan && npm run security:audit && npm run security:signatures",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:package": "node scripts/package-release.mjs",
    "check": "npm run security:scan && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "js-yaml": "4.3.0",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.16"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.8"
    },
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "type": "module",
  "displayName": "LumaBoard",
  "author": "RaphaelTW",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaphaelTW/LumaBoard.git"
  },
  "homepage": "https://github.com/RaphaelTW/LumaBoard#readme",
  "bugs": {
    "url": "https://github.com/RaphaelTW/LumaBoard/issues"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "unrs-resolver": true
  }
}
