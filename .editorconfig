# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,html,xml,svg,toml,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.ps1]
indent_style = space
indent_size = 2

[*.{png,jpg,jpeg,gif,webp,ico}]
insert_final_newline = false
trim_trailing_whitespace = false

[*.tsbuildinfo]
insert_final_newline = false
trim_trailing_whitespace = false

[package-lock.json]
indent_style = space
indent_size = 2
